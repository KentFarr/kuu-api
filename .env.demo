# ======================================================================
# DEMO VALUES ONLY. Used by docker-compose.demo.yml (`make demo`).
# Nothing here is a real credential: Stripe, Pterodactyl and SMTP are all
# faked locally. Never copy these into a real .env.
# ======================================================================

STRIPE_SECRET_KEY=sk_test_demo_not_a_real_key
# demo-checkout signs its fake events with this same value.
STRIPE_WEBHOOK_SECRET=whsec_demo_not_a_real_secret
STRIPE_PRICE_2GB=price_demo_2gb
STRIPE_PRICE_4GB=price_demo_4gb
STRIPE_PRICE_8GB=price_demo_8gb
STRIPE_PRICE_16GB=price_demo_16gb
STRIPE_PRICE_24GB=price_demo_24gb
STRIPE_PRICE_32GB=price_demo_32gb

# The fake panel (cmd/fakeptero) accepts any API key.
PTERODACTYL_URL=http://fakeptero:8090
PTERODACTYL_API_KEY=demo
NODE_IDS=1

DATABASE_URL=postgres://kuu:kuu-demo@postgres:5432/kuu?sslmode=disable

# Mailpit catches every email; view them at http://localhost:8025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@kuu.demo

# Empty Cloudflare token: subdomain DNS is skipped.
CLOUDFLARE_API_TOKEN=

ADMIN_BEARER_TOKEN=demo-admin-token
API_PUBLIC_URL=http://localhost:8081
PORTAL_LINK_SECRET=demo-portal-link-secret
CORS_ALLOWED_ORIGIN=http://localhost:3000
